// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopSettings {
  shopDomain         String              @id
  locationGid        String?
  locationName       String?
  telegramChatId     String?
  lastSyncedAt       DateTime?           @db.Timestamptz(3)
  lowStockThreshold  Int                 @default(5)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  inventoryLevels    InventoryLevel[]
  webhookEvents      WebhookEvent[]
  monitoredLocations MonitoredLocation[]
}

model MonitoredLocation {
  shopDomain          String
  locationGid         String
  locationName        String?
  // NULL means Shopify activity has not been verified, including migrated locations.
  isActive            Boolean?
  syncStatus          LocationSyncStatus @default(PENDING)
  baselineCompletedAt DateTime?          @db.Timestamptz(3)
  lastSyncedAt        DateTime?          @db.Timestamptz(3)
  // Future location writers increment this under a location lock; M1 does not dual-write.
  version             BigInt             @default(0)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)
  shop                ShopSettings       @relation(fields: [shopDomain], references: [shopDomain], onDelete: Restrict)

  @@id([shopDomain, locationGid])
}

enum LocationSyncStatus {
  PENDING
  READY
}

model InventoryLevel {
  id                String           @id @default(cuid())
  shopDomain        String
  locationGid       String
  inventoryItemGid  String
  variants          Json
  sku               String?
  availableQuantity Int
  isLowStock        Boolean
  isCurrent         Boolean          @default(true)
  shopifyUpdatedAt  DateTime?        @db.Timestamptz(3)
  syncedAt          DateTime         @default(now()) @db.Timestamptz(3)
  shop              ShopSettings     @relation(fields: [shopDomain], references: [shopDomain], onDelete: Restrict)
  alerts            InventoryAlert[]

  @@unique([shopDomain, locationGid, inventoryItemGid])
}

model InventoryAlert {
  id                        String             @id @default(cuid())
  inventoryLevelId          String
  quantityAtTrigger         Int
  thresholdAtTrigger        Int
  status                    AlertStatus        @default(ACTIVE)
  notificationStatus        NotificationStatus @default(PENDING)
  triggeredAt               DateTime           @default(now()) @db.Timestamptz(3)
  resolvedAt                DateTime?          @db.Timestamptz(3)
  notifiedAt                DateTime?          @db.Timestamptz(3)
  notificationChatId        String?
  notificationText          String?
  notificationAttempts      Int                @default(0)
  notificationNextAttemptAt DateTime?          @db.Timestamptz(3)
  notificationLeaseUntil    DateTime?          @db.Timestamptz(3)
  notificationLeaseToken    String?
  notificationError         String?
  inventoryLevel            InventoryLevel     @relation(fields: [inventoryLevelId], references: [id], onDelete: Restrict)

  // Enforced by a partial unique index in the SQL migration: one ACTIVE alert per item/location.
  @@index([inventoryLevelId])
  @@index([notificationNextAttemptAt])
}

model WebhookEvent {
  id          String       @id @default(cuid())
  shopDomain  String
  webhookId   String
  processedAt DateTime     @default(now()) @db.Timestamptz(3)
  shop        ShopSettings @relation(fields: [shopDomain], references: [shopDomain], onDelete: Restrict)

  @@unique([shopDomain, webhookId])
}

enum AlertStatus {
  ACTIVE
  RESOLVED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}
