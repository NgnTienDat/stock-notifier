# Choose a long URL-safe password before starting PostgreSQL.
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL="postgresql://stocknotifier:${POSTGRES_PASSWORD}@127.0.0.1:5433/stocknotifier?schema=public"

# Shopify CLI supplies these only to `npm run dev`, not to a separate inventory worker.
# For inventory:worker, fill these privately using the same app as the active CLI config:
# API_KEY = client_id in shopify.app.stock-notifier-app.toml; API_SECRET = that app's secret.
# APP_URL = current HTTPS tunnel URL printed by npm run dev; update after tunnel changes.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_inventory,read_products,read_locations

# Server only. Create a bot with BotFather; never use a VITE_ prefix.
# Set the per-store Chat ID in embedded Settings; run npm run notifications:worker.
TELEGRAM_BOT_TOKEN=
